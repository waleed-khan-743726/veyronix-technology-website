# ==============================================================================
# VEYRONIX TECHNOLOGY — BACKEND ENVIRONMENT VARIABLES (TEMPLATE)
# Note: Copy this file to .env for local testing. NEVER commit real values to Git.
# Set these variables in the Vercel Dashboard for production deployment.
# ==============================================================================

# --- Google Sheets Database (Service Account) ---
# 1. Create a service account in Google Cloud Console with Google Sheets API enabled.
# 2. Share your CRM Google Sheet with the service account email (Editor role).
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
# For multi-line private keys, wrap in double quotes and preserve \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# --- Transactional Email (Resend API) ---
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Veyronix Inquiries <onboarding@resend.dev>"
EMAIL_TO=veyronixtechnologies@gmail.com

# --- Firebase Admin SDK (Server-side Auth Verification) ---
# Download service account key from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=veyronix-technologies
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@veyronix-technologies.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (Public Web Config for /admin login) ---
# Found in Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourPublicFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=veyronix-technologies.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=veyronix-technologies
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=veyronix-technologies.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Admin Security Whitelist ---
# Comma-separated list of approved administrator email addresses allowed to access /admin API
ADMIN_EMAILS=veyronixtechnologies@gmail.com,waleed@veyronix.com

# --- Google Analytics 4 (Client & Server Reporting) ---
GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_PROPERTY_ID=123456789

# --- Site URL Configuration ---
NEXT_PUBLIC_SITE_URL=https://veyronixtechnologies.vercel.app
